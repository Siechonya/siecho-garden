{% macro menuItem(fileOrFolderName, fileOrFolder, step, currentPath) %}
    {%if fileOrFolder.isNote or fileOrFolder.isFolder%}
        <div x-show="isOpen" style="display:none" class="{{'filelist' if step>0}}">
            {%if fileOrFolder.isNote and not fileOrFolder.hide %}
                <div @click.stop class="notelink {{ 'active-note' if fileOrFolder.permalink === permalink}}">
                    {%- if not meta.noteIconsSettings.filetree -%}<i icon-name="sticky-note" aria-hidden="true"></i>{%- endif -%}
                    <a data-note-icon="{{fileOrFolder.noteIcon}}" style="text-decoration: none;" class="filename" href="{{fileOrFolder.permalink}}">{{fileOrFolder.name}} </a>
                </div>
            {% elif fileOrFolder.isFolder%}
                <div class="folder inner-folder"  x-data="{isOpen: $persist(false).as('{{currentPath}}')}" @click.stop="isOpen=!isOpen">
                    <div class="foldername-wrapper align-icon">
                    <i x-show="isOpen" style="display: none;"  icon-name="chevron-down"></i>
                    <i x-show="!isOpen"  icon-name="chevron-right"></i>
                    <span class="foldername">{{fileOrFolderName}}</span>
                    </div>
                    {% for fileOrFolderName, child in fileOrFolder %}
                        {{menuItem(fileOrFolderName, child, step+1, (currentPath+"/"+fileOrFolderName))}}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        {%endif%}
    {% endmacro %}
    
    <div class="filetree-shell"
            x-data="{
                isDesktop: window.innerWidth >= 1400,
                desktopOpen: true,
                showFilesMobile: false,
                init() {
                    try {
                        this.desktopOpen = localStorage.getItem('siecho:filetree:desktop-open') !== 'false';
                    } catch (error) { /* Storage may be unavailable; keep the default. */ }
                },
                get filesVisible() {
                    return this.isDesktop ? this.desktopOpen : this.showFilesMobile;
                },
                toggleDesktop() {
                    this.desktopOpen = !this.desktopOpen;
                    try {
                        localStorage.setItem('siecho:filetree:desktop-open', String(this.desktopOpen));
                    } catch (error) { /* Toggling still works without storage. */ }
                },
                closeFiles() {
                    if (!this.filesVisible) return;
                    if (this.isDesktop) {
                        this.toggleDesktop();
                        this.$nextTick(() => this.$refs.desktopToggle.focus());
                    } else {
                        this.showFilesMobile = false;
                        this.$nextTick(() => this.$refs.mobileToggle.focus());
                    }
                },
                resize() {
                    const desktop = window.innerWidth >= 1400;
                    if (desktop !== this.isDesktop) this.showFilesMobile = false;
                    this.isDesktop = desktop;
                }
            }"
            x-on:resize.window="resize()"
            @keydown.escape.stop="closeFiles()">

        <button type="button" class="filetree-toggle sidebar-control"
                :class="{ 'is-open': desktopOpen }"
                x-ref="desktopToggle" x-show.important="isDesktop" style="display: none;"
                @click="toggleDesktop()" aria-controls="filetree-panel"
                :aria-expanded="String(desktopOpen)"
                :aria-label="desktopOpen ? '收起文件树' : '展开文件树'"
                :title="desktopOpen ? '收起文件树' : '展开文件树'">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                <path d="M9 3v18"></path>
                <path :d="desktopOpen ? 'm16 9-3 3 3 3' : 'm13 9 3 3-3 3'"></path>
            </svg>
        </button>

        <div x-show.important="!isDesktop" style="display: none;">
            {%include "components/filetreeNavbar.njk"%}
        </div>

        <div x-show="showFilesMobile && !isDesktop" @click="closeFiles()"
             style="display:none;" class="fullpage-overlay" aria-hidden="true"></div>

      <nav id="filetree-panel" aria-label="文件树" class="filetree-sidebar"
           x-show.important="filesVisible" style="display: none;"
           x-transition:enter="filetree-motion"
           x-transition:enter-start="filetree-motion-hidden"
           x-transition:enter-end="filetree-motion-visible"
           x-transition:leave="filetree-motion"
           x-transition:leave-start="filetree-motion-visible"
           x-transition:leave-end="filetree-motion-hidden">
        <button type="button" class="filetree-close sidebar-control"
                x-show.important="!isDesktop" style="display: none;"
                @click="closeFiles()" aria-label="关闭文件树" title="关闭文件树">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
        </button>
        {% for imp in dynamics.filetree.beforeTitle %}
            {% include imp %}
        {% endfor %}
         <a href="/" style="text-decoration: none;">
               <h1 style="text-align:center;">{{meta.siteName}}</h1>
         </a>
         {% for imp in dynamics.filetree.afterTitle %}
            {% include imp %}
        {% endfor %}
        {% if settings.dgEnableSearch === true%}
            <div style="display: flex; justify-content: center;">
                {% include "components/searchButton.njk" %}
            </div>
        {%endif%}
         <div class="folder" x-data="{isOpen: true}">
               {%- for fileOrFolderName, fileOrFolder in filetree -%}
                  {{menuItem(fileOrFolderName, fileOrFolder, 0, fileOrFolderName)}}
               {%- endfor -%}
         </div>
      </nav>
    </div>
