<!-- A monochrome outline icon; SVG avoids emoji rendering on Windows. -->
<button type="button" id="toggle-right-toc-btn" class="sidebar-control"
        aria-label="收起标题目录" title="收起标题目录" aria-expanded="true">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
       stroke-linejoin="round" aria-hidden="true">
    <path d="M3 6h10M3 12h7M3 18h10"></path>
    <path class="toc-toggle-chevron" d="m17 8 4 4-4 4"></path>
  </svg>
</button>

<script>
  (function() {
    const btn = document.getElementById('toggle-right-toc-btn');
    const toc = document.querySelector('.sidebar .sidebar-container > .toc');
    if (!btn) return;
    if (!toc) {
      btn.remove();
      return;
    }
    if (!toc.id) toc.id = 'right-toc-panel';
    btn.setAttribute('aria-controls', toc.id);
    const chevron = btn.querySelector('.toc-toggle-chevron');
    function sync() {
      const visible = !document.body.classList.contains('hide-right-toc');
      btn.setAttribute('aria-expanded', String(visible));
      btn.setAttribute('aria-label', visible ? '收起标题目录' : '展开标题目录');
      btn.title = visible ? '收起标题目录' : '展开标题目录';
      chevron.setAttribute('d', visible ? 'm17 8 4 4-4 4' : 'm21 8-4 4 4 4');
    }
    btn.addEventListener('click', () => {
      document.body.classList.toggle('hide-right-toc');
      sync();
    });
    sync();
  })();
</script>
