<nav class="navbar">
    <div class="navbar-inner">
        <button type="button" class="filetree-menu sidebar-control" x-ref="mobileToggle"
                @click="showFilesMobile=!showFilesMobile" aria-controls="filetree-panel"
                :aria-expanded="String(showFilesMobile)" aria-label="切换文件树" title="切换文件树">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
        {% for imp in dynamics.filetree.beforeTitle %}
            {% include imp %}
        {% endfor %}
        <a href="/" style="text-decoration: none;">
            <h1 style="margin: 15px !important;">{{meta.siteName}}</h1>
        </a>
        {% for imp in dynamics.filetree.afterTitle %}
            {% include imp %}
        {% endfor %}
    </div>
    
    {% if settings.dgEnableSearch === true%}
        {% include "components/searchButton.njk" %}
    {%endif%}
</nav>